# Find eigenvalues and eigenvectors of a covariance matrix

import numpy as np
import matplotlib.pyplot as plt

C = np.array([[3, 1],
              [1, 3]])

values, vectors = np.linalg.eigh(C)

print("Eigenvalues:", values)
print("Eigenvectors (columns):\n", np.round(vectors, 4))

for i in range(2):
    plt.quiver(0, 0, vectors[0, i], vectors[1, i],
               angles="xy", scale_units="xy", scale=1,
               label=f"Eigenvector {i+1}")

plt.xlim(-1.1, 1.1)
plt.ylim(-1.1, 1.1)
plt.axhline(0, color="gray")
plt.axvline(0, color="gray")
plt.grid(True)
plt.legend()
plt.title("Eigenvectors of Covariance Matrix")
plt.show()
