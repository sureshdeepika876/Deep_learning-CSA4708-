# Flatten an image matrix and calculate total pixel intensity

import numpy as np
import matplotlib.pyplot as plt

image = np.array([[10, 20, 30],
                  [40, 50, 60],
                  [70, 80, 90]])

vector = image.flatten()

print("Flattened vector:", vector)
print("Total pixel intensity:", np.sum(image))

plt.bar(range(1, 10), vector)
plt.xlabel("Vector Index")
plt.ylabel("Pixel Intensity")
plt.title("Flattened Image Pixel Intensities")
plt.show()
