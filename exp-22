# Apply linear regression to student-performance data

import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

np.random.seed(42)

X = np.linspace(0, 10, 80).reshape(-1, 1)
y = 5 * X.ravel() + 2 * np.sin(X.ravel())
y += np.random.normal(0, 2, 80)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

model = LinearRegression()
model.fit(X_train, y_train)

train_mse = mean_squared_error(
    y_train, model.predict(X_train)
)
test_mse = mean_squared_error(
    y_test, model.predict(X_test)
)

print("Training MSE:", round(train_mse, 4))
print("Testing MSE:", round(test_mse, 4))

plt.scatter(X_test, y_test, label="Actual Marks")
plt.scatter(X_test, model.predict(X_test),
            label="Predicted Marks")
plt.xlabel("Study Hours")
plt.ylabel("Marks")
plt.title("Linear Regression")
plt.legend()
plt.show()
