# Calculate normal distribution probability

import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm

mean = 70
std_dev = 10

probability = norm.cdf(80, mean, std_dev) - norm.cdf(60, mean, std_dev)
print("P(60 <= X <= 80):", round(probability, 4))

x = np.linspace(40, 100, 400)
y = norm.pdf(x, mean, std_dev)

plt.plot(x, y)
mask = (x >= 60) & (x <= 80)
plt.fill_between(x[mask], y[mask], alpha=0.4)
plt.xlabel("Exam Mark")
plt.ylabel("Probability Density")
plt.title("Normal Distribution")
plt.show()
