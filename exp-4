# Update weights using gradient descent

import numpy as np
import matplotlib.pyplot as plt

W = np.array([0.7, 0.5, 0.9])
gradient = np.array([0.2, 0.1, 0.3])
learning_rate = 0.1

updated_W = W - learning_rate * gradient

print("Updated weights:", updated_W)

x = np.arange(3)

plt.bar(x - 0.18, W, 0.36, label="Original")
plt.bar(x + 0.18, updated_W, 0.36, label="Updated")
plt.xticks(x, ["w1", "w2", "w3"])
plt.ylabel("Weight")
plt.title("Gradient Descent Weight Update")
plt.legend()
plt.show()
