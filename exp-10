# Find the principal direction of a sensor covariance matrix

import numpy as np
import matplotlib.pyplot as plt

C = np.array([[5, 2],
              [2, 2]])

values, vectors = np.linalg.eigh(C)
idx = np.argsort(values)[::-1]
values = values[idx]
vectors = vectors[:, idx]

print("Eigenvalues:", np.round(values, 4))
print("Principal eigenvector:", np.round(vectors[:, 0], 4))

for i in range(2):
    plt.quiver(0, 0, vectors[0, i], vectors[1, i],
               angles="xy", scale_units="xy", scale=1,
               label=f"Eigenvector {i+1}")

plt.xlim(-1.1, 1.1)
plt.ylim(-1.1, 1.1)
plt.axhline(0, color="gray")
plt.axvline(0, color="gray")
plt.grid(True)
plt.legend()
plt.title("Sensor Covariance Eigenvectors")
plt.show()
