# Demonstrate underfitting and overfitting

import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

np.random.seed(7)

X = np.linspace(-1, 1, 35).reshape(-1, 1)
y = np.sin(2 * np.pi * X.ravel())
y += np.random.normal(0, 0.15, 35)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

X_plot = np.linspace(-1, 1, 300).reshape(-1, 1)

plt.scatter(X_train, y_train, label="Training Data")

for degree in [2, 15]:
    model = make_pipeline(
        PolynomialFeatures(degree),
        LinearRegression()
    )
    model.fit(X_train, y_train)

    train_mse = mean_squared_error(
        y_train, model.predict(X_train)
    )
    test_mse = mean_squared_error(
        y_test, model.predict(X_test)
    )

    print(f"Degree {degree} train MSE:",
          round(train_mse, 4))
    print(f"Degree {degree} test MSE:",
          round(test_mse, 4))

    plt.plot(X_plot, model.predict(X_plot),
             label=f"Degree {degree}")

plt.ylim(-2, 2)
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Underfitting and Overfitting")
plt.legend()
plt.show()
