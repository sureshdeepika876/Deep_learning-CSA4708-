# Compare entropy and uncertainty

import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import entropy

P = np.array([0.9, 0.1])
Q = np.array([0.5, 0.5])

H_P = entropy(P, base=2)
H_Q = entropy(Q, base=2)

print("Entropy P:", round(H_P, 4), "bits")
print("Entropy Q:", round(H_Q, 4), "bits")
print("Greater uncertainty:", "Q" if H_Q > H_P else "P")

plt.bar(["P = [0.9, 0.1]", "Q = [0.5, 0.5]"],
        [H_P, H_Q])
plt.ylabel("Entropy (bits)")
plt.title("Entropy Comparison")
plt.show()
