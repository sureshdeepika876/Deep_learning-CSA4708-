# Multiply input and weight matrices

import numpy as np
import matplotlib.pyplot as plt

X = np.array([[30, 60],
              [35, 70]])

W = np.array([[0.2, 0.5],
              [0.4, 0.3]])

Y = X @ W

print("Predicted output matrix:\n", Y)

plt.imshow(Y, cmap="viridis")
plt.colorbar()
plt.xticks([0, 1], ["Output 1", "Output 2"])
plt.yticks([0, 1], ["Location 1", "Location 2"])

for (i, j), value in np.ndenumerate(Y):
    plt.text(j, i, str(value), ha="center",
             va="center", color="white")

plt.title("Predicted Output Matrix")
plt.show()
